# Public frontend settings. Never put service_role/provider secrets in VITE_.
VITE_SUPABASE_URL=http://127.0.0.1:55421
VITE_SUPABASE_ANON_KEY=""
VITE_SUPPORT_EMAIL=support@example.test
VITE_SALES_EMAIL=sales@example.test
VITE_PRIVACY_EMAIL=privacy@example.test
VITE_OPERATOR_NAME=Operador de esta instalación
# Optional telemetry; blank by default.
VITE_SENTRY_DSN=""
VITE_APP_VERSION=1.0.0
# Optional installed Chromium channel for local E2E tests.
LOCAL_BROWSER_CHANNEL=""
# Server settings: supabase/functions/.env.example (separate ignored file).
# Optional support WhatsApp; international digits, blank disables the button.
VITE_SUPPORT_WHATSAPP=""
