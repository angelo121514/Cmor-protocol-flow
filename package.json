{
  "name": "cmor-flow",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "type-check": "tsc -b --pretty false",
    "preview": "vite preview",
    "security-check": "tsx scripts/security-check.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:security": "node scripts/test-database-local.mjs",
    "test:integration": "node scripts/test-database-local.mjs",
    "backup-db": "bash scripts/backup-db.sh",
    "restore-db": "bash scripts/restore-db.sh",
    "test:local": "vitest run --config vitest.local.config.ts",
    "test:database": "node scripts/test-database-local.mjs",
    "test:docs": "node scripts/check-spec.mjs",
    "type-check:edge": "tsc -p tsconfig.edge.json --pretty false",
    "setup:local": "node scripts/setup-local.mjs",
    "seed:local": "node scripts/seed-local.mjs",
    "demo:code": "node scripts/demo-code.mjs",
    "check:public": "node scripts/check-public.mjs"
  },
  "dependencies": {
    "@sentry/react": "^8.55.2",
    "@supabase/supabase-js": "^2.86.0",
    "crypto-js": "^4.2.0",
    "lucide-react": "^0.555.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.5.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@eslint/js": "^9.39.1",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.61.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "autoprefixer": "^10.4.17",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^25.0.1",
    "msw": "^2.14.6",
    "postcss": "^8.4.35",
    "supabase": "^2.107.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^8.2.1",
    "vitest": "^4.1.11"
  },
  "description": "Plataforma de c\u00f3digo abierto para gesti\u00f3n de restaurantes con React y Supabase",
  "engines": {
    "node": ">=22.12.0"
  }
}
